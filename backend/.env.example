# ==========================================
# MADANOLOGY BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

PORT=5000
NODE_ENV=development

# Astrology API Provider Selection: 'mock' | 'vedic_rishi' | 'prokerala'
# If set to 'mock' or if keys are empty, realistic astrological dummy data is generated.
ASTROLOGY_API_PROVIDER=mock

# --- Option 1: Vedic Rishi API (https://www.astrologyapi.com/) ---
VEDIC_RISHI_USER_ID=your_vedic_rishi_user_id_here
VEDIC_RISHI_API_KEY=your_vedic_rishi_api_key_here

# --- Option 2: Prokerala Astrology API (https://api.prokerala.com/) ---
PROKERALA_CLIENT_ID=your_prokerala_client_id_here
PROKERALA_CLIENT_SECRET=your_prokerala_client_secret_here
