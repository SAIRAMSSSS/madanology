# ==========================================
# MADANOLOGY FRONTEND ENVIRONMENT
# ==========================================

# Google Places API Key for Birth Place Autocomplete
# If left blank, Madanology automatically uses the built-in intelligent fallback
# with instant auto-suggestions for Indian and global cities (including Coimbatore).
VITE_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Backend API base url (empty string allows Vite proxy /api to work seamlessly)
VITE_API_BASE_URL=
